# The kernel.
#
# What `linen build` compiles into liblinen.a, and what the N-API addon
# links against. Everything reachable from outside is `export fn`;
# everything else is free to change.
#
# THE BOUNDARY IS BUFFERS, NOT VALUES
# -----------------------------------
# Nothing here exports a function taking a `Point`. A small struct
# crossing the C ABI is where "nearly right" becomes silent corruption
# rather than a crash, and the rules for aggregates differ per platform.
#
# Instead the boundary is flat integer buffers: coordinates go in as a
# packed array, results come out as another. Only pointers and lengths
# cross, which every ABI agrees about.
#
# It is also the shape that makes the crossing cheap. A JS loop calling
# the kernel once per triangle would spend most of its time on the
# transition; one call with ten thousand triangles spends it computing.
#
#   wrong:  for (t of triangles) kernel.area(t)
#   right:  kernel.areas(coordinates, count, out)
#
# COORDINATES ARE MICRONS
# -----------------------
# Every i32 here is a whole number of microns. The range is 1 micron to
# 10 metres, which is 10^7 units — well inside i32, and the products
# reach 10^14, which is why every result is i64.

shape Point
  x i32
  y i32

shape Point3
  x i32
  y i32
  z i32

# --- predicates -------------------------------------------------------

# Which side of a->b the point c falls on.
#
#   > 0   left of a->b, a counter-clockwise turn
#   = 0   collinear, EXACTLY
#   < 0   right
#
# The most used predicate in a BREP kernel, and the one floating point
# gets wrong in the way that matters: three points collinear by
# construction come out as a tiny non-zero determinant, and the kernel
# then decides a point is left of an edge here and right of it there.
# In integers the sign of the determinant IS the answer.
fn orient2d(a Point, b Point, c Point) i64
  return (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)

# Twice the signed area of a triangle.
#
# Twice, and never halved: the doubled value is always a whole number
# where the halved one is not, and comparing areas, testing a winding or
# summing a polygon are all unaffected by the constant factor. Halving
# is the only step that could lose anything.
fn double_area(a Point, b Point, c Point) i64
  return orient2d(a: a, b: b, c: c)

# The squared distance between two points.
#
# Squared, and never the root: a square root leaves the integers, and
# every kernel use of a distance — comparing two, finding the nearest,
# testing a tolerance — works on the square. A real length is a display
# concern.
fn distance_squared(a Point, b Point) i64
  return (b.x - a.x) * (b.x - a.x) + (b.y - a.y) * (b.y - a.y)

# Widen an i64 into i128 before it is multiplied.
#
# Written out rather than left implicit: arithmetic widens i32 to i64,
# which is right everywhere except here. Making every subtraction in the
# language i128 to serve one predicate would be the wrong trade.
fn wide(value i64) i128
  return value + 0

# Which side of the plane through a, b, c the point d falls on.
#
#   > 0   above, the side the normal of a->b->c points to
#   = 0   COPLANAR, exactly
#   < 0   below
#
# A 3x3 determinant: six products of three coordinates. A coordinate
# reaches 10^7, so a triple product reaches 10^21 and i64 is two orders
# short — and a wrapped determinant does not merely lose precision, it
# can carry the WRONG SIGN, placing a point on the wrong side of a face.
# That is what i128 is here for.
fn orient3d(a Point3, b Point3, c Point3, d Point3) i128
  let bx = wide(value: b.x - a.x)
  let by = wide(value: b.y - a.y)
  let bz = wide(value: b.z - a.z)
  let cx = wide(value: c.x - a.x)
  let cy = wide(value: c.y - a.y)
  let cz = wide(value: c.z - a.z)
  let dx = wide(value: d.x - a.x)
  let dy = wide(value: d.y - a.y)
  let dz = wide(value: d.z - a.z)
  return bx * (cy * dz - cz * dy) - by * (cx * dz - cz * dx) + bz * (cx * dy - cy * dx)

# --- the boundary -----------------------------------------------------

# Twice the signed area of one triangle, from six loose coordinates.
#
# The scalar entry point, for a caller with a single triangle. Six i32
# rather than three Points: no aggregate crosses the ABI.
export fn linen_double_area(ax i32, ay i32, bx i32, by i32, cx i32, cy i32) i64
  return double_area(a: Point(x: ax, y: ay), b: Point(x: bx, y: by), c: Point(x: cx, y: cy))

# The squared distance between two points, from four coordinates.
export fn linen_distance_squared(ax i32, ay i32, bx i32, by i32) i64
  return distance_squared(a: Point(x: ax, y: ay), b: Point(x: bx, y: by))

# Which side of a->b the point c falls on, as a sign.
#
# Returns -1, 0 or 1 rather than the determinant: a caller asking "which
# side" does not want a number whose magnitude it must then ignore, and
# the sign is what every use of this actually branches on.
export fn linen_orientation(ax i32, ay i32, bx i32, by i32, cx i32, cy i32) i32
  let determinant = orient2d(a: Point(x: ax, y: ay), b: Point(x: bx, y: by), c: Point(x: cx, y: cy))
  return if determinant > 0 then 1 else if determinant < 0 then 0 - 1 else 0

# Which side of the plane through a, b, c the point d falls on: 1 above,
# -1 below, 0 coplanar.
#
# A sign rather than the determinant, and for a stronger reason here than
# in 2D: the value reaches 10^21, which no integer type on the other side
# of this boundary can hold. JS has BigInt but the sign is what every
# caller branches on, and returning i32 keeps the crossing free of a heap
# allocation per call.
export fn linen_orientation3(ax i32, ay i32, az i32, bx i32, by i32, bz i32, cx i32, cy i32, cz i32, dx i32, dy i32, dz i32) i32
  let a = Point3(x: ax, y: ay, z: az)
  let b = Point3(x: bx, y: by, z: bz)
  let c = Point3(x: cx, y: cy, z: cz)
  let d = Point3(x: dx, y: dy, z: dz)
  let determinant = orient3d(a: a, b: b, c: c, d: d)
  return if determinant > 0 then 1 else if determinant < 0 then 0 - 1 else 0
