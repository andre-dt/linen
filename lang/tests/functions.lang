# Functions: parameters, results, calls.

fn double(n i32) i32
  return n * 2

fn add(a i32, b i32) i32
  return a + b

fn zero() i32
  return 0

test "calls a function"
  throw "double(21) should be 42" unless double(21) == 42

test "passes several arguments"
  throw "add(20, 22) should be 42" unless add(20, 22) == 42

test "calls with no arguments"
  throw "zero() should be 0" unless zero() == 0

test "nests calls"
  throw "double(add(1, 2)) should be 6" unless double(add(1, 2)) == 6

test "calls inside arithmetic"
  throw "double(3) + add(1, 1) should be 8" unless double(3) + add(1, 1) == 8
