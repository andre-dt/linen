# Functions: parameters, results, calls.

fn double(n i32) i32
  return n * 2

fn add(a i32, b i32) i32
  return a + b

fn zero() i32
  return 0

test "calls a function"
  throw "double(n: 21) should be 42" unless double(n: 21) == 42

test "calls inside arithmetic"
  throw "double(n: 3) + add(a: 1, b: 1) should be 8" unless double(n: 3) + add(a: 1, b: 1) == 8

test "calls with no arguments"
  throw "zero() should be 0" unless zero() == 0

test "nests calls"
  throw "double(n: add(a: 1, b: 2)) should be 6" unless double(n: add(a: 1, b: 2)) == 6

test "passes several arguments"
  throw "add(a: 20, b: 22) should be 42" unless add(a: 20, b: 22) == 42
