# `if` in both of its roles.
#
#   statement    if <cond> <block> [else <block>]  — no value, `else` optional
#   expression   if <cond> then <a> else <b>       — one line, `else` required
#
# The expression form is one line because an expression can appear
# mid-line, where opening an indented block would put the layout rule in
# conflict with itself.

fn sign(n i32) i32
  if n < 0
    return -1
  if n > 0
    return 1
  return 0

fn abs_statement(n i32) i32
  if n < 0
    return -n
  else
    return n

fn abs_expression(n i32) i32
  return if n < 0 then -n else n

fn grade(n i32) i32
  if n >= 90
    return 4
  else
    if n >= 80
      return 3
    else
      return 2

fn clamp(n i32, low i32, high i32) i32
  if n < low
    return low
  if n > high
    return high
  return n

test "if as a statement, without else"
  throw "sign(n: -5) should be -1" unless sign(n: -5) == -1
  throw "sign(n: 5) should be 1" unless sign(n: 5) == 1
  throw "sign(n: 0) should be 0" unless sign(n: 0) == 0

test "if as a statement, with else"
  throw "abs_statement(n: -4) should be 4" unless abs_statement(n: -4) == 4
  throw "abs_statement(n: 4) should be 4" unless abs_statement(n: 4) == 4
  throw "abs_statement(n: 0) should be 0" unless abs_statement(n: 0) == 0

test "if as an expression"
  throw "abs_expression(n: -4) should be 4" unless abs_expression(n: -4) == 4
  throw "abs_expression(n: 4) should be 4" unless abs_expression(n: 4) == 4

test "an if expression in a binding"
  let smaller = if 3 < 5 then 3 else 5
  throw "smaller should be 3" unless smaller == 3

test "an if expression as an argument"
  throw "abs_expression(n: if true then -7 else 7) should be 7" unless abs_expression(n: if true then -7 else 7) == 7

test "if expressions nest"
  let x = if true then (if false then 1 else 2) else 3
  throw "x should be 2" unless x == 2

test "nested if statements"
  throw "grade(n: 95) should be 4" unless grade(n: 95) == 4
  throw "grade(n: 85) should be 3" unless grade(n: 85) == 3
  throw "grade(n: 70) should be 2" unless grade(n: 70) == 2

test "several ifs in sequence"
  throw "clamp(n: 5, low: 0, high: 10) should be 5" unless clamp(n: 5, low: 0, high: 10) == 5
  throw "clamp(n: -5, low: 0, high: 10) should be 0" unless clamp(n: -5, low: 0, high: 10) == 0
  throw "clamp(n: 15, low: 0, high: 10) should be 10" unless clamp(n: 15, low: 0, high: 10) == 10

test "a condition can be any bool expression"
  let x = if 2 + 2 == 4 and 1 < 2 then 1 else 0
  throw "x should be 1" unless x == 1

test "an if statement inside a test"
  if 1 < 2
    throw "true should hold" unless true
  else
    throw "this body should never run" if true
