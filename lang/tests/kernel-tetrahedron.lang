# A tetrahedron — four points, four faces, the smallest possible solid.
#
# Every face is a triangle and every pair of faces shares an edge, so
# there is no triangulation diagonal anywhere: whatever the outline
# drawing does here is what the geometry actually is.
#
# It is also the shape orient3d is defined by. The determinant of its
# four points IS six times its volume, so a degenerate tetrahedron and a
# zero determinant are the same statement.
#
# Rendered to kernel-tetrahedron.png beside this file.

shape Point3
  x i32
  y i32
  z i32

fn wide(value i64) i128
  return value + 0

fn orient3d(a Point3, b Point3, c Point3, d Point3) i128
  let bx = wide(value: b.x - a.x)
  let by = wide(value: b.y - a.y)
  let bz = wide(value: b.z - a.z)
  let cx = wide(value: c.x - a.x)
  let cy = wide(value: c.y - a.y)
  let cz = wide(value: c.z - a.z)
  let dx = wide(value: d.x - a.x)
  let dy = wide(value: d.y - a.y)
  let dz = wide(value: d.z - a.z)
  return bx * (cy * dz - cz * dy) - by * (cx * dz - cz * dx) + bz * (cx * dy - cy * dx)

fn corners(size i32) [Point3; 4]
  return [
    Point3(x: 0, y: 0, z: 0),
    Point3(x: size, y: 0, z: 0),
    Point3(x: size / 2, y: size, z: 0),
    Point3(x: size / 2, y: size / 2, z: size)]

fn triangles() [i32; 12]
  return [
    0, 2, 1,
    0, 1, 3,
    1, 2, 3,
    2, 0, 3]

test "a flattened tetrahedron has none"
  let flat = [
    Point3(x: 0, y: 0, z: 0),
    Point3(x: 100, y: 0, z: 0),
    Point3(x: 50, y: 100, z: 0),
    Point3(x: 50, y: 50, z: 0)]
  throw "a flat tetrahedron has no volume" unless orient3d(a: flat[0], b: flat[1], c: flat[2], d: flat[3]) == 0

test "every triangle faces outward"
  let t = corners(size: 200)
  # The centroid: the average of all four corners.
  let inside = Point3(x: 125, y: 87, z: 50)
  let indices = triangles()
  for i in 0 .. 4
    let a = t[indices[i * 3]]
    let b = t[indices[i * 3 + 1]]
    let c = t[indices[i * 3 + 2]]
    throw "a face winds the wrong way" unless orient3d(a: a, b: b, c: c, d: inside) < 0

test "six times the volume is the determinant"
  # Not proportional to it — equal to it. That identity is why orient3d
  # is the predicate a kernel is built on rather than one convenience
  # among several.
  let t = corners(size: 100)
  throw "a tetrahedron of side 100 has a determinant" unless orient3d(a: t[0], b: t[1], c: t[2], d: t[3]) > 0

test draws "a flatter tetrahedron"
  solid(
    points: [
      300, 300, 0,
      0, 300, 0,
      150, 0, 0,
      150, 150, 110],
    triangles: triangles())

test draws "a tetrahedron"
  solid(
    points: [
      260, 260, 0,
      0, 260, 0,
      130, 0, 0,
      130, 130, 260],
    triangles: triangles())
