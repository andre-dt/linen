# Recursion, which is how iteration is written when there is nothing to
# mutate.

fn countdown(n i32) i32
  return if n == 0 then 0 else countdown(n: n - 1)

fn sum_to(n i32) i32
  return if n == 0 then 0 else n + sum_to(n: n - 1)

fn factorial(n i32) i32
  return if n <= 1 then 1 else n * factorial(n: n - 1)

fn fibonacci(n i32) i32
  return if n < 2 then n else fibonacci(n: n - 1) + fibonacci(n: n - 2)

fn gcd(a i32, b i32) i32
  return if b == 0 then a else gcd(a: b, b: a % b)

fn power(base i32, exponent i32) i32
  return if exponent == 0 then 1 else base * power(base: base, exponent: exponent - 1)

fn is_even(n i32) bool
  # Mutual recursion: each calls the other.
  return if n == 0 then true else is_odd(n: n - 1)

fn is_odd(n i32) bool
  return if n == 0 then false else is_even(n: n - 1)

test "a base case that returns immediately"
  throw "countdown(n: 0) should be 0" unless countdown(n: 0) == 0

test "a recursion that branches twice"
  throw "fibonacci(n: 0) should be 0" unless fibonacci(n: 0) == 0
  throw "fibonacci(n: 1) should be 1" unless fibonacci(n: 1) == 1
  throw "fibonacci(n: 7) should be 13" unless fibonacci(n: 7) == 13

test "an accumulating recursion"
  throw "sum_to(n: 0) should be 0" unless sum_to(n: 0) == 0
  throw "sum_to(n: 1) should be 1" unless sum_to(n: 1) == 1
  throw "sum_to(n: 5) should be 15" unless sum_to(n: 5) == 15
  throw "sum_to(n: 10) should be 55" unless sum_to(n: 10) == 55

test "factorial"
  throw "factorial(n: 0) should be 1" unless factorial(n: 0) == 1
  throw "factorial(n: 1) should be 1" unless factorial(n: 1) == 1
  throw "factorial(n: 5) should be 120" unless factorial(n: 5) == 120

test "mutual recursion"
  throw "is_even(n: 0) should hold" unless is_even(n: 0)
  throw "is_odd(n: 1) should hold" unless is_odd(n: 1)
  throw "is_even(n: 10) should hold" unless is_even(n: 10)
  throw "is_even(n: 7) should not hold" if is_even(n: 7)

test "recursion on two arguments"
  throw "gcd(a: 12, b: 8) should be 4" unless gcd(a: 12, b: 8) == 4
  throw "gcd(a: 17, b: 5) should be 1" unless gcd(a: 17, b: 5) == 1
  throw "power(base: 2, exponent: 8) should be 256" unless power(base: 2, exponent: 8) == 256

test "recursion terminates"
  throw "countdown(n: 5) should be 0" unless countdown(n: 5) == 0
  throw "countdown(n: 20) should be 0" unless countdown(n: 20) == 0
