# Wrapping a long list across lines.
#
# A list inside brackets or parentheses is not finished at the end of the
# line — a `[` or `(` that is still open says so unambiguously. Without
# this, the eight corners of a box have to go on one line, and the line
# that describes a solid is the one nobody can read.
#
# The layout rule still governs BLOCKS. This is only about a list that
# has already been opened: indentation inside it means nothing, because
# the bracket is what says where it ends.

shape Point3
  x i32
  y i32
  z i32

fn corners(size i32) [Point3; 4]
  return [
    Point3(x: 0, y: 0, z: 0),
    Point3(x: size, y: 0, z: 0),
    Point3(x: size, y: size, z: 0),
    Point3(x: 0, y: size, z: 0)]

fn total(
  a i32,
  b i32,
  c i32) i64
  return a + b + c

fn sum_of(
  values [i32; 3]) i64
  return values[0] + values[1] + values[2]

test "a parameter list can wrap"
  throw "the sum should be 6" unless total(a: 1, b: 2, c: 3) == 6

test "a plain array literal can wrap"
  let xs = [
    1,
    2,
    3]
  throw "the wrapped array should hold" unless sum_of(values: xs) == 6

test "an argument list can wrap"
  throw "wrapped arguments should work" unless total(
    a: 10,
    b: 20,
    c: 30) == 60

test "an array literal can wrap"
  let box = corners(size: 100)
  throw "the first corner is the origin" unless box[0].x == 0
  throw "the third corner is far" unless box[2].x == 100 and box[2].y == 100

test "wrapping does not change the value"
  let flat = [1, 2, 3]
  let wrapped = [
    1,
    2,
    3]
  throw "the two should agree" unless sum_of(values: flat) == sum_of(values: wrapped)
