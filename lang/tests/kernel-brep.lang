# BREP — the boundary representation.
#
# A solid described by its BOUNDARY: the faces that separate inside from
# outside, the edges where faces meet, the vertices where edges meet.
# Not a soup of triangles — a triangle soup does not know that two
# triangles share an edge, and every operation a kernel performs is
# about exactly that.
#
#   Body   ── Shell  ── Face  ── Loop  ── CoEdge ── Edge ── Vertex
#                        │                  │        │
#                     a plane          direction   two vertices
#
# WHY EACH LEVEL EXISTS
# ---------------------
# Every one of them earns its place by holding something no other level
# can:
#
#   Vertex   a point, shared by every edge that ends there
#   Edge     two vertices, shared by the TWO faces that meet along it
#   CoEdge   an edge as ONE face uses it, with a direction
#   Loop     a closed circuit of coedges, bounding one face
#   Face     a loop and the plane it lies in
#   Shell    faces that together enclose a volume
#   Body     shells: one outer, and one per cavity
#
# The CoEdge is the one that looks redundant and is not. An edge is
# shared by two faces, and each traverses it in the OPPOSITE direction —
# that is what makes both loops wind counter-clockwise seen from outside
# their own face. Without it, an edge would need to know which of its two
# faces was asking.
#
# WHY INDICES AND NOT REFERENCES
# ------------------------------
# A Face holds the INDEX of its loop, not the loop itself. Topology is
# cyclic — a face refers to an edge that refers back to the face — and a
# value that contained itself could not be built at all. Indices break
# the cycle without a pointer, and they are what STEP writes too.

shape Vertex
  x i32
  y i32
  z i32

# An edge, as the two vertices it runs between.
shape Edge
  from i32
  to i32

# An edge as one face uses it.
#
# `forward` says whether this face traverses the edge from its `from` to
# its `to`, or the other way. The two faces sharing an edge disagree
# about this, which is precisely the point.
shape CoEdge
  edge i32
  forward bool

# A closed circuit of coedges, bounding one face.
shape Loop
  coedges List<i32>

# A planar face: one outer loop, and the plane it lies in.
#
# The plane is given by three of its own vertices rather than by a normal
# and a distance: three points ARE a plane, they are already exact
# integers, and a normal would be a direction that generally has no
# integer representation.
shape Face
  outer i32
  a i32
  b i32
  c i32

# Everything a solid is made of, in one value.
#
# Flat lists rather than nesting the shapes inside each other, because a
# Face refers to a Loop by index and the index has to mean a position in
# something. This is that something.
shape Body
  vertices List<Vertex>
  edges List<Edge>
  coedges List<CoEdge>
  loops List<Loop>
  faces List<Face>

fn wide(value i64) i128
  return value + 0

# Which side of the plane through a, b, c the point d falls on.
fn orient3d(a Vertex, b Vertex, c Vertex, d Vertex) i128
  let bx = wide(value: b.x - a.x)
  let by = wide(value: b.y - a.y)
  let bz = wide(value: b.z - a.z)
  let cx = wide(value: c.x - a.x)
  let cy = wide(value: c.y - a.y)
  let cz = wide(value: c.z - a.z)
  let dx = wide(value: d.x - a.x)
  let dy = wide(value: d.y - a.y)
  let dz = wide(value: d.z - a.z)
  return bx * (cy * dz - cz * dy) - by * (cx * dz - cz * dx) + bz * (cx * dy - cy * dx)

# --- reading a body ---------------------------------------------------

fn vertex_of(body Body, index i32) Vertex
  return at(list: body.vertices, index: index)

fn edge_of(body Body, index i32) Edge
  return at(list: body.edges, index: index)

fn coedge_of(body Body, index i32) CoEdge
  return at(list: body.coedges, index: index)

fn loop_of(body Body, index i32) Loop
  return at(list: body.loops, index: index)

fn face_of(body Body, index i32) Face
  return at(list: body.faces, index: index)

# Where a coedge starts, for the face that owns it.
#
# The whole reason a CoEdge exists: the same edge answers differently
# depending on which face is asking.
fn coedge_start(body Body, index i32) i32
  let coedge = coedge_of(body: body, index: index)
  let edge = edge_of(body: body, index: coedge.edge)
  return if coedge.forward then edge.from else edge.to

fn coedge_end(body Body, index i32) i32
  let coedge = coedge_of(body: body, index: index)
  let edge = edge_of(body: body, index: coedge.edge)
  return if coedge.forward then edge.to else edge.from

# --- building one ------------------------------------------------------

fn empty_body() Body
  return Body(
    vertices: list(),
    edges: list(),
    coedges: list(),
    loops: list(),
    faces: list())

test "an empty body has nothing in it"
  let body = empty_body()
  throw "no vertices" unless length(list: body.vertices) == 0
  throw "no faces" unless length(list: body.faces) == 0

test "a vertex can be read back"
  let body = Body(
    vertices: push(list: list(), value: Vertex(x: 10, y: 20, z: 30)),
    edges: list(),
    coedges: list(),
    loops: list(),
    faces: list())
  let v = vertex_of(body: body, index: 0)
  throw "x should be 10" unless v.x == 10
  throw "z should be 30" unless v.z == 30

test "an edge names two vertices"
  let body = Body(
    vertices: push(list: push(list: list(), value: Vertex(x: 0, y: 0, z: 0)), value: Vertex(x: 100, y: 0, z: 0)),
    edges: push(list: list(), value: Edge(from: 0, to: 1)),
    coedges: list(),
    loops: list(),
    faces: list())
  let e = edge_of(body: body, index: 0)
  throw "it runs from the first" unless e.from == 0
  throw "to the second" unless e.to == 1
  throw "the far end is at 100" unless vertex_of(body: body, index: e.to).x == 100

test "a coedge traverses its edge in a direction"
  # The property that makes CoEdge worth having. The same edge, used by
  # two faces, is walked in opposite directions — so both loops wind
  # counter-clockwise seen from outside their own face.
  let body = Body(
    vertices: push(list: push(list: list(), value: Vertex(x: 0, y: 0, z: 0)), value: Vertex(x: 100, y: 0, z: 0)),
    edges: push(list: list(), value: Edge(from: 0, to: 1)),
    coedges: push(list: push(list: list(), value: CoEdge(edge: 0, forward: true)), value: CoEdge(edge: 0, forward: false)),
    loops: list(),
    faces: list())

  throw "the forward coedge starts at the edge's from" unless coedge_start(body: body, index: 0) == 0
  throw "and ends at its to" unless coedge_end(body: body, index: 0) == 1
  throw "the reversed one starts at the to" unless coedge_start(body: body, index: 1) == 1
  throw "and ends at the from" unless coedge_end(body: body, index: 1) == 0

test "a loop holds its coedges in order"
  let circuit = push(list: push(list: push(list: list(), value: 0), value: 1), value: 2)
  let body = Body(
    vertices: list(),
    edges: list(),
    coedges: list(),
    loops: push(list: list(), value: Loop(coedges: circuit)),
    faces: list())
  let ring = loop_of(body: body, index: 0)
  throw "three coedges" unless length(list: ring.coedges) == 3
  throw "in the order given" unless at(list: ring.coedges, index: 1) == 1

test "a face names the plane it lies in"
  let body = Body(
    vertices: list(),
    edges: list(),
    coedges: list(),
    loops: list(),
    faces: push(list: list(), value: Face(outer: 0, a: 0, b: 1, c: 2)))
  let face = face_of(body: body, index: 0)
  throw "it bounds loop 0" unless face.outer == 0
  throw "its plane is given by three vertices" unless face.a == 0 and face.b == 1 and face.c == 2

test "the topology of a triangle closes"
  # One face, three edges, three coedges in a loop. The circuit closes
  # when each coedge ends where the next begins — which is what makes it
  # a loop rather than three unrelated edges.
  let body = triangle_body()
  let ring = loop_of(body: body, index: 0)
  throw "three coedges" unless length(list: ring.coedges) == 3

  let first = at(list: ring.coedges, index: 0)
  let second = at(list: ring.coedges, index: 1)
  let third = at(list: ring.coedges, index: 2)

  throw "the first should end where the second begins" unless coedge_end(body: body, index: first) == coedge_start(body: body, index: second)
  throw "the second should end where the third begins" unless coedge_end(body: body, index: second) == coedge_start(body: body, index: third)
  throw "the third should close the circuit" unless coedge_end(body: body, index: third) == coedge_start(body: body, index: first)

test "a face's vertices are not collinear"
  # Three collinear points name no plane, so a face built on them has no
  # inside and no outside. Exactly zero, because the coordinates are
  # integers.
  let body = triangle_body()
  let face = face_of(body: body, index: 0)
  let a = vertex_of(body: body, index: face.a)
  let b = vertex_of(body: body, index: face.b)
  let c = vertex_of(body: body, index: face.c)
  let off = Vertex(x: a.x, y: a.y, z: a.z + 1000)
  throw "the three should name a real plane" if orient3d(a: a, b: b, c: c, d: off) == 0

# A single triangular face: the smallest thing with a closed loop.
fn triangle_body() Body
  let vertices = push(
    list: push(
      list: push(list: list(), value: Vertex(x: 0, y: 0, z: 0)),
      value: Vertex(x: 100, y: 0, z: 0)),
    value: Vertex(x: 0, y: 100, z: 0))

  let edges = push(
    list: push(
      list: push(list: list(), value: Edge(from: 0, to: 1)),
      value: Edge(from: 1, to: 2)),
    value: Edge(from: 2, to: 0))

  let coedges = push(
    list: push(
      list: push(list: list(), value: CoEdge(edge: 0, forward: true)),
      value: CoEdge(edge: 1, forward: true)),
    value: CoEdge(edge: 2, forward: true))

  let circuit = push(list: push(list: push(list: list(), value: 0), value: 1), value: 2)

  return Body(
    vertices: vertices,
    edges: edges,
    coedges: coedges,
    loops: push(list: list(), value: Loop(coedges: circuit)),
    faces: push(list: list(), value: Face(outer: 0, a: 0, b: 1, c: 2)))
