# Functions calling functions, and the shapes a call can take.

fn identity(n i32) i32
  return n

fn double(n i32) i32
  return n * 2

fn add(a i32, b i32) i32
  return a + b

fn add_three(a i32, b i32, c i32) i32
  return a + b + c

fn constant() i32
  return 42

fn quadruple(n i32) i32
  # A function calling another one declared above it.
  return double(double(n))

fn describe(n i32) i32
  # Several statements, several bindings, one result.
  let doubled = double(n)
  let plus_one = doubled + 1
  return plus_one

test "no arguments"
  throw "constant() should be 42" unless constant() == 42

test "one argument"
  throw "identity(7) should be 7" unless identity(7) == 7
  throw "double(21) should be 42" unless double(21) == 42

test "several arguments"
  throw "add(20, 22) should be 42" unless add(20, 22) == 42
  throw "add_three(1, 2, 3) should be 6" unless add_three(1, 2, 3) == 6

test "a call as an argument"
  throw "double(double(3)) should be 12" unless double(double(3)) == 12
  throw "add(double(2), double(3)) should be 10" unless add(double(2), double(3)) == 10

test "a call inside arithmetic"
  throw "double(3) + 1 should be 7" unless double(3) + 1 == 7
  throw "1 + double(3) should be 7" unless 1 + double(3) == 7
  throw "double(3) * double(2) should be 24" unless double(3) * double(2) == 24

test "a call inside a comparison"
  throw "double(3) should be 6" unless double(3) == 6
  throw "double(3) should be more than 5" unless double(3) > 5

test "an expression as an argument"
  throw "double(1 + 2) should be 6" unless double(1 + 2) == 6
  throw "add(1 + 1, 2 * 2) should be 6" unless add(1 + 1, 2 * 2) == 6

test "a function that calls another"
  throw "quadruple(3) should be 12" unless quadruple(3) == 12

test "a function with several statements"
  throw "describe(5) should be 11" unless describe(5) == 11

test "arguments are evaluated in order they are written"
  throw "add(1, 2) should be 3" unless add(1, 2) == 3
  throw "add(2, 1) should be 3" unless add(2, 1) == 3
