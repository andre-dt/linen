# `while` and `for`, both statements.
#
# A `for` range is HALF-OPEN: `0 .. 3` visits 0, 1 and 2. That way
# `0 .. n` means "n times", which is the thing people write, and two
# adjacent ranges meet without overlapping.

test "a while that never runs"
  while false
    throw "this body should never run" if true
  throw "true should hold" unless true

test "a for over a small range"
  for i in 0 .. 3
    throw "i should be at least 0" unless i >= 0
    throw "i should be less than 3" unless i < 3

test "a range that is empty"
  # start == end visits nothing, which is what makes `0 .. n` safe when
  # n happens to be zero.
  for i in 0 .. 0
    throw "this body should never run" if true
  throw "true should hold" unless true

test "a range that starts above zero"
  for i in 5 .. 8
    throw "i should be at least 5" unless i >= 5
    throw "i should be less than 8" unless i < 8

test "the loop variable is visible in the body"
  for i in 1 .. 2
    throw "i should be 1" unless i == 1

test "a range from expressions"
  let low = 1
  let high = 3
  for i in low .. high
    throw "i should be at least low" unless i >= low
    throw "i should be less than high" unless i < high

test "loops nest"
  for i in 0 .. 2
    for j in 0 .. 2
      throw "i + j should be at least 0" unless i + j >= 0
      throw "i + j should be at most 2" unless i + j <= 2

test "an if inside a loop"
  for i in 0 .. 3
    if i == 0
      throw "i should be less than 1" unless i < 1
    else
      throw "i should be more than 0" unless i > 0

test "a loop inside an if"
  if true
    for i in 0 .. 2
      throw "i should be less than 2" unless i < 2
  else
    throw "this body should never run" if true

test "a while with a condition that is already false"
  let done = true
  while not done
    throw "this body should never run" if true
  throw "done should hold" unless done
